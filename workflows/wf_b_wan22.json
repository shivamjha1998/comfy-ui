{
    "_meta": {
        "title": "WF-B: WAN 2.2 Animate (kijai WanVideoWrapper)",
        "description": "Full-body character replacement using kijai's ComfyUI-WanVideoWrapper. Replaces the native ComfyUI WAN code path which had a known weakness on full-body replacement. Patched at runtime by gradio_app/workflow.py patch_wf_b().",
        "version": "0.4.0",
        "patch_targets": {
            "target_video":          "node 1  → inputs.video + node 1 → inputs.frame_load_cap + node 14 → inputs.num_frames",
            "reference_image":       "node 2  → inputs.image",
            "prompt":                "node 10 → inputs.positive_prompt",
            "relight_lora_weight":   "node 12 → inputs.strength_0",
            "steps":                 "node 15 → inputs.steps",
            "segment_length_frames": "node 1 → inputs.frame_load_cap, node 14 → inputs.num_frames"
        }
    },
    "1": {
        "class_type": "VHS_LoadVideo",
        "_meta": {"title": "Load Target Video"},
        "inputs": {
            "video": "__PATCH_TARGET_VIDEO__",
            "force_rate": 16,
            "force_size": "Custom",
            "custom_width": 832,
            "custom_height": 480,
            "frame_load_cap": 81,
            "skip_first_frames": 0,
            "select_every_nth": 1
        }
    },
    "2": {
        "class_type": "LoadImage",
        "_meta": {"title": "Load Reference Character"},
        "inputs": {"image": "__PATCH_REFERENCE_IMAGE__"}
    },
    "3": {
        "class_type": "OnnxDetectionModelLoader",
        "_meta": {"title": "Load YOLO + ViTPose"},
        "inputs": {
            "vitpose_model": "vitpose-l-wholebody.onnx",
            "yolo_model": "yolov10m.onnx",
            "onnx_device": "CUDAExecutionProvider"
        }
    },
    "4": {
        "class_type": "PoseAndFaceDetection",
        "_meta": {"title": "Pose + Face Detection (outputs 0=pose 1=face 3=bboxes)"},
        "inputs": {
            "model": ["3", 0],
            "images": ["1", 0],
            "width": 832,
            "height": 480
        }
    },
    "5": {
        "class_type": "DrawViTPose",
        "_meta": {"title": "Draw Pose Skeletons → IMAGE"},
        "inputs": {
            "pose_data": ["4", 0],
            "width": 832,
            "height": 480,
            "score_threshold": 0.5,
            "body_stick_width": 4,
            "hand_stick_width": 2,
            "draw_head": false,
            "retarget_padding": 0
        }
    },
    "6": {
        "class_type": "DownloadAndLoadSAM2Model",
        "_meta": {"title": "Load SAM2.1 → SAM2MODEL"},
        "inputs": {
            "model": "sam2.1_hiera_large.safetensors",
            "segmentor": "video",
            "device": "cuda",
            "precision": "fp16"
        }
    },
    "7": {
        "class_type": "Sam2Segmentation",
        "_meta": {"title": "SAM2 Foreground Mask (full video, bbox-prompted, propagated)"},
        "inputs": {
            "sam2_model": ["6", 0],
            "image": ["1", 0],
            "keep_model_loaded": false,
            "bboxes": ["4", 3]
        }
    },
    "18": {
        "class_type": "GrowMaskWithBlur",
        "_meta": {"title": "Dilate + soften SAM2 mask (so body region is fully covered, not tight to silhouette)"},
        "inputs": {
            "mask": ["7", 0],
            "expand": 30,
            "incremental_expandrate": 0,
            "tapered_corners": true,
            "flip_input": false,
            "blur_radius": 5.0,
            "lerp_alpha": 1.0,
            "decay_factor": 1.0,
            "fill_holes": true
        }
    },
    "8": {
        "class_type": "CLIPVisionLoader",
        "_meta": {"title": "Load CLIP Vision Encoder"},
        "inputs": {"clip_name": "clip_vision_h.safetensors"}
    },
    "9": {
        "class_type": "WanVideoClipVisionEncode",
        "_meta": {"title": "Encode Reference Image → CLIP_VISION embeds"},
        "inputs": {
            "clip_vision": ["8", 0],
            "image_1": ["2", 0],
            "strength_1": 1.0,
            "strength_2": 1.0,
            "crop": "center",
            "combine_embeds": "average",
            "force_offload": true
        }
    },
    "10": {
        "class_type": "WanVideoTextEncodeCached",
        "_meta": {"title": "UMT5-XXL Text Encode (positive + negative)"},
        "inputs": {
            "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors",
            "precision": "bf16",
            "positive_prompt": "__PATCH_PROMPT__",
            "negative_prompt": "low quality, blurry, distorted, deformed, bad anatomy, extra limbs, fused fingers, watermark, text, jpeg artifacts",
            "quantization": "disabled",
            "use_disk_cache": false,
            "device": "gpu"
        }
    },
    "11": {
        "class_type": "WanVideoVAELoader",
        "_meta": {"title": "Load Wan 2.1 VAE (16-channel)"},
        "inputs": {
            "model_name": "Wan2.1_VAE.pth",
            "precision": "bf16"
        }
    },
    "12": {
        "class_type": "WanVideoLoraSelectMulti",
        "_meta": {"title": "Select LoRAs (relight only; no lightx2v acceleration)"},
        "inputs": {
            "lora_0": "WanAnimate_relight_lora_fp16.safetensors",
            "strength_0": 0.6,
            "lora_1": "none",
            "strength_1": 1.0,
            "lora_2": "none",
            "strength_2": 1.0,
            "lora_3": "none",
            "strength_3": 1.0,
            "lora_4": "none",
            "strength_4": 1.0,
            "low_mem_load": false,
            "merge_loras": false
        }
    },
    "13": {
        "class_type": "WanVideoModelLoader",
        "_meta": {"title": "Load WAN 2.2 Animate 14B (fp8 KJ v2)"},
        "inputs": {
            "model": "Wan2_2-Animate-14B_fp8_scaled_e4m3fn_KJ_v2.safetensors",
            "base_precision": "fp16_fast",
            "quantization": "disabled",
            "load_device": "offload_device",
            "attention_mode": "sdpa",
            "lora": ["12", 0]
        }
    },
    "14": {
        "class_type": "WanVideoAnimateEmbeds",
        "_meta": {"title": "Fuse Animate Conditioning → image_embeds"},
        "inputs": {
            "vae": ["11", 0],
            "width": 832,
            "height": 480,
            "num_frames": 81,
            "force_offload": true,
            "frame_window_size": 77,
            "colormatch": "disabled",
            "pose_strength": 1.5,
            "face_strength": 0.0,
            "clip_embeds": ["9", 0],
            "ref_images": ["2", 0],
            "pose_images": ["5", 0],
            "tiled_vae": false
        }
    },
    "15": {
        "class_type": "WanVideoSampler",
        "_meta": {"title": "WanVideo Diffusion Sampler"},
        "inputs": {
            "model": ["13", 0],
            "image_embeds": ["14", 0],
            "text_embeds": ["10", 0],
            "steps": 40,
            "cfg": 5.0,
            "shift": 5.0,
            "seed": 42,
            "force_offload": true,
            "scheduler": "unipc",
            "riflex_freq_index": 0,
            "denoise_strength": 1.0,
            "rope_function": "comfy",
            "batched_cfg": false
        }
    },
    "16": {
        "class_type": "WanVideoDecode",
        "_meta": {"title": "Decode Latents → IMAGE frames"},
        "inputs": {
            "vae": ["11", 0],
            "samples": ["15", 0],
            "enable_vae_tiling": true,
            "tile_x": 272,
            "tile_y": 272,
            "tile_stride_x": 144,
            "tile_stride_y": 128,
            "normalization": "default"
        }
    },
    "17": {
        "class_type": "VHS_VideoCombine",
        "_meta": {"title": "Combine Frames → MP4"},
        "inputs": {
            "images": ["16", 0],
            "frame_rate": 16,
            "loop_count": 0,
            "filename_prefix": "wan_animate",
            "format": "video/h264-mp4",
            "pix_fmt": "yuv420p",
            "crf": 19,
            "save_metadata": true,
            "trim_to_audio": false,
            "pingpong": false,
            "save_output": true
        }
    }
}
