# Copy this file to .env and fill in the values that apply.
# .env is gitignored; .env.example is checked in.

# Google Gemini API key for the "Nano Banana" style-match step in gradio_app.
# Get one at https://aistudio.google.com/apikey
# If unset, the style-match toggle in the UI will fall back to using the raw
# source image (the face-swap pipeline still works without it).
GEMINI_API_KEY=

# Override the Gemini image-generation model. Defaults to original Nano Banana
# (gemini-2.5-flash-image) because it's the only image-gen model available on
# the FREE tier. Nano Banana Pro returns 429 RESOURCE_EXHAUSTED with limit:0
# unless you've enabled billing on your Google Cloud project.
#
# Free tier (default):
#   gemini-2.5-flash-image          (original Nano Banana, ~$0.04/image when billed)
# Paid tier (requires billing enabled in Google Cloud Console):
#   gemini-3.1-flash-image-preview  (Nano Banana 2, ~$0.045/image, 4K capable)
#   gemini-3-pro-image-preview      (Nano Banana Pro, best instructions, ~$0.13/image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Override default ports / hosts if needed.
# COMFYUI_HOST=127.0.0.1
# COMFYUI_PORT=8188
# GRADIO_HOST=127.0.0.1          # set to 0.0.0.0 to expose on the LAN
# GRADIO_PORT=7860
