# Copy this file to .env and fill in the values that apply.
# .env is gitignored; .env.example is checked in.

# Google Gemini API key for the "Nano Banana" style-match step in gradio_app.
# Get one at https://aistudio.google.com/apikey
# If unset, the style-match toggle in the UI will fall back to using the raw
# source image (the face-swap pipeline still works without it).
GEMINI_API_KEY=

# Override the Gemini image-generation model. ALL Gemini image-gen models
# require billing enabled on the Google Cloud project — the free tier returns
# 429 RESOURCE_EXHAUSTED with limit:0 for image generation as of May 2026.
#
# Default: gemini-3-pro-image-preview (Nano Banana Pro). In our testing, Pro is
# the only model that reliably follows the multi-image identity-preservation
# instruction — the cheaper Flash variant routinely returned the wrong face.
# Worth the ~$0.13 per call.
#
# Other options if you want to A/B:
#   gemini-2.5-flash-image          (original Nano Banana, ~$0.04/image)
#   gemini-3.1-flash-image-preview  (Nano Banana 2, ~$0.045/image)
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Override default ports / hosts if needed.
# COMFYUI_HOST=127.0.0.1
# COMFYUI_PORT=8188
# GRADIO_HOST=127.0.0.1          # set to 0.0.0.0 to expose on the LAN
# GRADIO_PORT=7860
